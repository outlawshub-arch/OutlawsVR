# ---- Unreal build output and local state ----
Binaries/
DerivedDataCache/
Intermediate/
Saved/
.vs/
*.sln
*.suo
*.VC.db
*.opensdf
*.sdf

# ---- Content: only what the runtime itself needs ----
# No LucasArts-derived assets: the game reads the player's own Outlaws Remastered install at runtime.
# Excluded: per-level imports (Content/Outlaws/<level>), converted movies and music, the per-level maps.
Content/*
!Content/Outlaws/
Content/Outlaws/*
!Content/Outlaws/Core/
!Content/Outlaws/Runtime/
!Content/Outlaws/Maps/
Content/Outlaws/Maps/*
!Content/Outlaws/Maps/L_Runtime.umap
# the held guns: only our recipes and points (REQ-RUNTIMEGUNS: no meshes or images; the game builds each gun from the
# player's own sprite)
!Content/HeldGuns/
Content/HeldGuns/*
!Content/HeldGuns/*.json
!Content/Credits/
# (BUG-DEVDIR) the grab points marked by hand on the bad guys' sprites: our own numbers, JSON only
!Content/GrabPoints/
Content/GrabPoints/*
!Content/GrabPoints/*.json
# Epic's first-person template (the project's default game mode still names it)
!Content/FirstPerson/
!Content/FirstPersonArms/
!Content/FPWeapon/
!Content/__ExternalActors__/
!Content/__ExternalObjects__/

# cook logs
Build/Android_ASTC/
Build/Windows/

# the build stamp the packaging scripts write (commit, branch, date; OutlawsBuildInfo.cpp)
Source/OutlawsRuntime/OutlawsBuildStamp.h

# generated by the Android build (UnrealBuildTool writes these from the engine templates)
Build/Android/src/
# per-user settings: the Android SDK/NDK/JDK paths (Config/UserEngine.ini.example), a local item folder
# (Config/UserGame.ini.example)
Config/User*.ini
# stray backups
*.bak
*.bak_*
